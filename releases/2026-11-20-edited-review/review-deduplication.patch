diff --git a/evolvmem/experience_v2/gate/review_edit.py b/evolvmem/experience_v2/gate/review_edit.py
new file mode 100644
index 0000000000000000000000000000000000000000..2f47da3db7841d12f12ccd668e400344770ee024
--- /dev/null
+++ b/evolvmem/experience_v2/gate/review_edit.py
@@ -0,0 +1,180 @@
+"""Check an edited human decision against fresh independent cards and active notes."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+import time
+
+from evolvmem.experience_v2.embedding_client import EmbeddingClient, EmbeddingFailure, note_text
+from evolvmem.experience_v2.gate import review_deduplication as groups, review_equivalence, review_guidance
+from evolvmem.experience_v2.llm_meter import default_http_transport, load_llm_endpoints_from_file
+from evolvmem.experience_v2.writer import CATEGORIES
+
+
+def _independent():
+    return f"""m.historical_anchor IS NULL AND m.closed_with IS NULL AND p.op='add'
+        AND p.source_kind IN ('agent','pipeline') AND NOT p.pinned AND p.importance<8
+        AND p.kind<>'habit' AND {groups._eligible('p')}"""
+
+
+class PreparedProjection:
+    """The writer still validates the exact final content digest, contracts and dimensions."""
+    def __init__(self, client, note, deadline):
+        self.client = client
+        self.note = note
+        self.deadline = deadline
+        self.retrieval_contract_id = client.retrieval_contract_id
+        self.legacy_contract_id = client.legacy_contract_id
+        self.result = None
+        self.failure = None
+
+    def prepare(self, text):
+        try:
+            self.result = self.client.encode_note(self.note, deadline=self.deadline)
+            return self.result.legacy_embedding
+        except EmbeddingFailure as exc:
+            self.failure = exc
+            raise
+
+    def encode_note(self, note):
+        if self.failure:
+            raise self.failure
+        if note != self.note or self.result is None:
+            raise EmbeddingFailure('experience_embedding_projection_invalid')
+        return self.result
+
+
+def _resources(note, deadline, source_kind, track):
+    client = EmbeddingClient.from_environment()
+    if not client:
+        return None, None, None
+    encode = PreparedProjection(client, note, min(deadline,time.monotonic()+2.0)).prepare
+    from evolvmem.product_policy import load_policy
+    policy = load_policy()
+    enabled = (policy.ai_processing_enabled if source_kind=='agent' else
+               policy.experience_backfill_enabled if track=='backfill' else policy.experience_pipeline_enabled)
+    if not (policy.valid and policy.experience_v2_enabled and enabled):
+        return encode, None, None
+    try:
+        from evolvmem.experience_v2.pipeline.live_worker import DEFAULT_JUDGE_MODEL, select_endpoint
+        endpoint = select_endpoint(load_llm_endpoints_from_file(),DEFAULT_JUDGE_MODEL,('strong','primary','fallback'))
+    except (OSError, ValueError):
+        endpoint = None
+    if not endpoint:
+        return encode, None, None
+
+    def send(model, messages, limit):
+        from evolvmem.experience_v2.llm_meter import LlmTransportError
+        remaining = deadline-time.monotonic()
+        if remaining <= 0:
+            raise LlmTransportError('edit_review_deadline')
+        return default_http_transport(endpoint, timeout_seconds=min(remaining, 15.0))(model, messages, limit)
+
+    return encode, DEFAULT_JUDGE_MODEL, send
+
+
+@dataclass
+class EditCheck:
+    original: tuple
+    final_key: str
+    note: dict | None = None
+    proposal: dict | None = None
+    projection: PreparedProjection | None = None
+
+    def keys(self):
+        return [cert['key'] for cert in (self.note, self.proposal) if cert]
+
+
+def _source(conn, owner, uid):
+    return conn.execute(f"""SELECT p.problem,p.solution,p.reusable_experience,p.scope,p.kind,p.misbelief,
+        p.category,p.source_kind,p.importance,m.rule_key,m.content_key,p.source_track,p.session_id,p.model
+        FROM experience_proposals p LEFT JOIN experience_review_members m ON m.owner_id=p.owner_id AND m.proposal_uid=p.uid
+        WHERE p.owner_id=%s AND p.uid=%s AND {_independent()}""", (owner,uid)).fetchone()
+
+
+def _nearby(conn, owner, uid, vector, final_key):
+    from evolvmem.experience_v2.gate.dedupe import DEFAULT_DEDUPE_THRESHOLD
+    proposals = conn.execute(f"""SELECT p.uid,1-(p.embedding <=> %s::vector)
+        FROM experience_proposals p JOIN experience_review_members m ON m.proposal_uid=p.uid AND m.owner_id=p.owner_id
+        WHERE p.owner_id=%s AND p.uid<>%s AND p.embedding IS NOT NULL AND m.content_key=m.rule_key
+          AND m.rule_key<>%s AND {_independent()} AND {groups.representative_filter('p')}
+        ORDER BY p.embedding <=> %s::vector,p.uid LIMIT 5""",(vector,owner,uid,final_key,vector)).fetchall()
+    notes = conn.execute("""SELECT id,1-(embedding <=> %s::vector) FROM experience_notes
+        WHERE owner_id=%s AND status='active' AND deleted_at IS NULL AND NOT pinned AND importance<8
+          AND embedding IS NOT NULL ORDER BY embedding <=> %s::vector,id LIMIT 5""",(vector,owner,vector)).fetchall()
+    return [[dict(uid=k,similarity=float(s)) for k,s in rows if s>=DEFAULT_DEDUPE_THRESHOLD]
+            for rows in (proposals,notes)]
+
+
+def prepare(conn, owner, uid, edits):
+    if not edits:
+        return None
+    source = _source(conn,owner,uid)
+    if not source or any(r.get("needs_check") for r in review_guidance.for_proposal(conn,owner,uid)):
+        return None
+    final = groups.edited_fields(source[:8],edits)
+    final_key = groups.rule_key(*final)
+    category = edits.get('category',source[6])
+    if (not all(final[:3]) or category not in CATEGORIES or int(edits.get('importance',source[8]))>=8
+            or (source[9] is not None and final_key == groups.rule_key(*source[:6]))):
+        return None
+    check = EditCheck(source,final_key)
+    note = dict(zip(('category','problem','solution','reusable_experience'),(category,*final[:3])))
+    deadline = time.monotonic()+25.0
+    from evolvmem.experience_v2.gate.dedupe import to_unit_vec768_literal
+    try:
+        encode, model, transport = _resources(note,deadline,source[7],source[11])
+        if not encode:
+            return check
+        client = getattr(encode,'__self__',None)
+        if isinstance(client,PreparedProjection):
+            check.projection = client
+        vector = to_unit_vec768_literal(encode(note_text(note)))
+    except (EmbeddingFailure, ValueError):
+        return check
+    nearby, notes = _nearby(conn,owner,uid,vector,final_key)
+    nearby = [p for p in nearby if not any(r.get('needs_check')
+              for r in review_guidance.for_proposal(conn,owner,p['uid']))]
+    track,session,proposer = source[-3:]
+    args = dict(track=track,session=session,proposer=proposer,model=model,transport=transport,budget=None,require_result=True)
+    if notes:
+        exact = groups.matching_notes(conn,owner,final_key,final,vector)
+        if exact and not exact[2] and exact[3]<8:
+            check.note = dict(target_kind='note',representative=exact[0],key=final_key,
+                              challenger_key=final_key,similarity=1.0,method='exact_final_rule')
+        elif not exact:
+            check.note = review_equivalence.certify(conn,uid,owner,final,[],notes=notes,**args)
+    if nearby:
+        proof = review_equivalence.certify(conn,uid,owner,final,nearby,**args)
+        if proof and proof['target_kind']=='proposal':
+            check.proposal = proof
+    return check
+
+
+def current_source(conn,owner,uid,edits,effective_key,check):
+    source = _source(conn,owner,uid)
+    return (source == check.original and effective_key==check.final_key
+            and groups.rule_key(*groups.edited_fields(source[:8],edits))==check.final_key)
+
+
+def lock_proposal(conn, owner, check):
+    proof = check.proposal
+    if not proof or proof['challenger_key']!=check.final_key:
+        return None
+    anchor = conn.execute(f"""SELECT p.problem,p.solution,p.reusable_experience,p.scope,p.kind,p.misbelief
+        FROM experience_proposals p JOIN experience_review_members m ON m.proposal_uid=p.uid AND m.owner_id=p.owner_id
+        WHERE p.uid=%s AND p.owner_id=%s AND m.content_key=m.rule_key AND m.rule_key=%s
+          AND {_independent()} AND {groups.representative_filter('p')} FOR UPDATE OF p,m SKIP LOCKED""",
+        (proof['representative'],owner,proof['key'])).fetchone()
+    if (anchor and groups.rule_key(*anchor)==proof['key'] and not any(r.get('needs_check')
+            for r in review_guidance.for_proposal(conn,owner,proof['representative'],freeze=True))):
+        return proof['representative']
+    return None
+
+
+
+def record_receipts(conn, decision_id, proofs):
+    if proofs:
+        conn.execute("""UPDATE proposal_decisions SET meta_json=COALESCE(meta_json,'{}'::jsonb)
+            || jsonb_build_object('edit_equivalence',%s::jsonb) WHERE decision_id=%s""",
+            (json.dumps(proofs,ensure_ascii=False),decision_id))
