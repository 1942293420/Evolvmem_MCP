+test('one in-flight decision per proposal, and an old library response cannot change the new view', async () => {
+  let release, posts=0, refreshes=0, renders=0, notices=0;
+  const E=client(async () => { posts++; return new Promise(resolve=>{release=resolve;}); });
+  Object.assign(E.state, {apiMode:'live', route:'review-inbox', ownerId:'owner', libraryCtx:'owner', selectedProposalUid:'p'});
+  E.state.proposals=[{uid:'p',status:'pending',_edited:true,problem:'edited',reasonDraft:'keep'}];
+  E.renderAll=()=>{renders++;}; E.toast=()=>{notices++;};
+  E.api.loadInbox=async()=>{refreshes++;};
+  const first=E.api.decideProposal('p','edit_accept',null,{problem:'edited'},'keep');
+  const again=E.api.decideProposal('p','accept');
+  assert.equal(posts,1);
+  assert.equal(E.api.reviewSubmitting('p'),true);
+  E.state.libraryCtx='peer'; E.state.libraryEpoch++;
+  const before=renders;
+  release(response(200,{ok:true}));
+  await Promise.all([first,again]);
+  assert.equal(E.api.reviewSubmitting('p'),false);
+  assert.deepEqual([refreshes,notices,renders-before],[0,0,0]);
+});
+
+
+for(const [error,code,expected] of [
+  ['review_edit_changed',409,'核对期间，提案或参照经验已更新'],
+  ['review_edit_verification_unavailable',503,'本次未采纳，修订内容已保留，请稍后重试'],
+  ['network_unavailable',503,'未收到审核结果'],
+  ['invalid_json',504,'未收到审核结果']
+])test('decision feedback preserves edits for '+error+' '+code, async()=>{
+  const E=client(async()=>response(code,{ok:false,error}));
+  Object.assign(E.state,{apiMode:'live',route:'review-inbox',selectedProposalUid:'p',ownerId:'owner',libraryCtx:'owner'});
+  const p={uid:'p',_edited:true,solution:'edited',reasonDraft:'reason'};
+  E.state.proposals=[p];
+  let notice;E.toast=text=>{notice=text;};
+  assert.equal(await E.api.decideProposal('p','edit_accept',null,{solution:'edited'},'reason'),false);
+  assert.ok(notice.includes(expected));assert.equal(p.solution,'edited');
+  assert.equal(p.reasonDraft,'reason');assert.equal(E.api.reviewSubmitting('p'),false);
+});
diff --git a/tests/stage2/test_edit_semantic_review.py b/tests/stage2/test_edit_semantic_review.py
new file mode 100644
index 0000000000000000000000000000000000000000..410b292c4c8dd36f210293960cdfdacf204109a0
--- /dev/null
+++ b/tests/stage2/test_edit_semantic_review.py
@@ -0,0 +1,205 @@
+"""A human edit must be checked against the final supplied rule text, outside row/group locks."""
+from types import SimpleNamespace
+import json
+
+import psycopg
+import pytest
+
+from evolvmem.experience_v2.gate import review_deduplication as groups
+from evolvmem.experience_v2.gate import review_equivalence
+from evolvmem.experience_v2.gate.dedupe import to_unit_vec768_literal
+from evolvmem.experience_v2.schema import apply_experience_migrations
+from evolvmem.experience_v2.writer import ExperienceWriter, Op, TicketIssuer
+from tests.stage2.test_review_rule_groups import SECRET, add, decide
+
+
+ORIGINAL = '实验收尾前保存测量表'
+ORIGINAL_RULE = '须保存本轮记录'
+TARGET = '实验结束后关闭本轮启用的工位灯'
+TARGET_RULE = '仅关闭这一轮实验中使用的工位灯'
+EDIT = '这次实验结束时将当轮开启的工位灯关掉'
+EDIT_RULE = '关灯的范围限定在本轮实验实际启用的工位'
+
+
+def make_review(c):
+    start = add(c,'edit-source',solution=ORIGINAL,rule=ORIGINAL_RULE)
+    old_peer = add(c,'edit-source-peer',solution=ORIGINAL,rule=ORIGINAL_RULE)
+    return start,old_peer
+
+
+def pending(c, tag='edit-target', *, platform='DemoLab'):
+    uid = add(c,tag,category='系统环境经验',solution=TARGET,rule=TARGET_RULE,
+              source='archive:98',session='other')
+    vec = to_unit_vec768_literal([1.0,0.0,0.0])
+    scope = {'platform':platform}
+    c.execute('UPDATE experience_proposals SET embedding=%s::vector,scope=%s::jsonb WHERE uid=%s',
+              (vec,json.dumps(scope),uid))
+    key = groups.rule_key('如何收尾',TARGET,TARGET_RULE,scope,'preference','')
+    c.execute('UPDATE experience_review_members SET rule_key=%s,content_key=%s WHERE proposal_uid=%s',
+              (key,key,uid))
+    return uid
+
+
+def formal(c):
+    issuer = TicketIssuer(SECRET,gate_id='seed-human')
+    ticket = issuer.issue(proposal_uid='manual:edit-fixture',decision_id='dec:edit-fixture',lane='user_fast')
+    return ExperienceWriter(SECRET).apply(c,ticket,Op(action='create',owner_id='test-u',actor_id='test-u',
+        request_id='edit-fixture',category='系统环境经验',kind='preference',scope={'platform':'DemoLab'},
+        problem='如何收尾',solution=TARGET,reusable_experience=TARGET_RULE,origin='manual',
+        embedding=[1.0]+[0.0]*767,evidence=[{'source':'archive:98','event':11}]))['experience']['id']
+
+
+def resources(monkeypatch,c,schema,dsn,uids,note_ids=(),*,expected=EDIT,allowed=True,on_judge=None,failure=None):
+    from evolvmem.experience_v2.gate import review_edit
+    backend=c.info.backend_pid
+    log=[]
+    def observe(phase):
+        # An independent client can immediately lock every input and target row while the
+        # slow external work runs. Transaction-ID/advisory locks cannot be hidden by a savepoint.
+        with psycopg.connect(dsn,options=f'-c search_path={schema},public -c lock_timeout=300ms') as observer:
+            advisory=observer.execute("""SELECT count(*) FROM pg_locks WHERE pid=%s
+                AND locktype='advisory' AND granted""",(backend,)).fetchone()[0]
+            assert advisory==0,phase
+            assert len(observer.execute('SELECT uid FROM experience_proposals WHERE uid=ANY(%s) FOR UPDATE NOWAIT',
+                                        (list(uids),)).fetchall())==len(uids)
+            assert len(observer.execute('SELECT id FROM experience_notes WHERE id=ANY(%s) FOR UPDATE NOWAIT',
+                                        (list(note_ids),)).fetchall())==len(note_ids)
+        log.append(phase)
+    def encode(text):
+        observe('embed')
+        assert expected in text and ORIGINAL not in text
+        return [1.0,0.0,0.0]
+    def judge(**kw):
+        observe('judge')
+        prompt = kw['messages'][-1]['content']
+        assert expected in prompt and TARGET in prompt and ORIGINAL not in prompt
+        if on_judge:
+            on_judge()
+        if failure=='budget':
+            from evolvmem.experience_v2.llm_meter import BudgetDeferred
+            raise BudgetDeferred('session','synthetic blocked budget')
+        if failure=='timeout':
+            from evolvmem.experience_v2.llm_meter import LlmTransportError
+            raise LlmTransportError('synthetic_timeout')
+        return SimpleNamespace(text=json.dumps({**dict.fromkeys(review_equivalence.FACETS,allowed),
+                                               'confidence':.99,'reason':'两边范围与动作一致'}),
+                               total_tokens=12,call_id=151)
+    monkeypatch.setattr(review_edit,'_resources',lambda *args,**kwargs:(encode,'independent-judge',object()))
+    monkeypatch.setattr(review_equivalence,'metered_llm',judge)
+    return log
+
+
+def test_edit_exact_still_closes_final_rule_only(pg_exp_schema):
+    c,_,_=pg_exp_schema
+    apply_experience_migrations(c)
+    edited,old_peer=make_review(c)
+    target=pending(c)
+    c.commit()
+    result=decide(c,edited,'edit_accept',{'solution':TARGET,'reusable_experience':TARGET_RULE})
+    states=dict(c.execute('SELECT uid,state FROM experience_proposals'))
+    assert result['state']=='accepted' and states[old_peer]=='review' and states[target]=='merged'
+
+
+@pytest.mark.parametrize('where',['queue','formal'])
+def test_edit_semantic_compares_final_text_without_holding_proposal_or_rule_locks(pg_exp_schema,monkeypatch,where):
+    c,schema,dsn=pg_exp_schema
+    apply_experience_migrations(c)
+    edited,old_peer=make_review(c)
+    target=pending(c) if where=='queue' else formal(c)
+    c.commit()
+    uids=(edited,old_peer,target) if where=='queue' else (edited,old_peer)
+    calls=resources(monkeypatch,c,schema,dsn,uids,(target,) if where=='formal' else ())
+    result=decide(c,edited,'edit_accept',{'solution':EDIT,'reusable_experience':EDIT_RULE})
+    assert {'embed','judge'}<=set(calls)
+    assert c.execute('SELECT state FROM experience_proposals WHERE uid=%s',(old_peer,)).fetchone()[0]=='review'
+    if where=='formal':
+        assert result['state']=='merged' and result['note']['id']==target
+    else:
+        assert result['note']['solution']==EDIT
+        assert c.execute('SELECT state,merged_into_uid FROM experience_proposals WHERE uid=%s',
+                         (target,)).fetchone()==('merged',result['note']['id'])
+    assert c.execute('SELECT count(*) FROM experience_notes').fetchone()[0]==1
+
+
+def test_edit_keeps_similar_rules_with_different_platforms_separate(pg_exp_schema,monkeypatch):
+    c,schema,dsn=pg_exp_schema
+    apply_experience_migrations(c)
+    edited,old_peer=make_review(c)
+    target=pending(c,platform='AnotherLab')
+    c.commit()
+    resources(monkeypatch,c,schema,dsn,(edited,old_peer,target))
+    result=decide(c,edited,'edit_accept',{'solution':EDIT,'reusable_experience':EDIT_RULE})
+    assert result['state']=='accepted'
+    assert c.execute('SELECT state FROM experience_proposals WHERE uid=%s',(target,)).fetchone()[0]=='review'
+
+
+@pytest.mark.parametrize('case',['opposite','budget','timeout','protected_while_judging','both_targets'])
+def test_edit_semantic_safety_and_joint_targets(pg_exp_schema,monkeypatch,case):
+    c,schema,dsn=pg_exp_schema
+    apply_experience_migrations(c)
+    edited,old_peer=make_review(c)
+    target=pending(c)
+    existing=formal(c) if case=='both_targets' else None
+    c.commit()
+    final_text='实验结束后将本轮使用的工位灯继续点亮' if case=='opposite' else EDIT
+    def protect():
+        with psycopg.connect(dsn,options=f'-c search_path={schema},public -c lock_timeout=300ms') as worker:
+            worker.execute('UPDATE experience_proposals SET pinned=true WHERE uid=%s',(target,))
+    calls=resources(monkeypatch,c,schema,dsn,(edited,old_peer,target),(existing,) if existing else (),
+                    expected=final_text,allowed=case!='opposite',on_judge=protect if case=='protected_while_judging' else None,
+                    failure=case)
+    try:
+        result=decide(c,edited,'edit_accept',{'solution':final_text,'reusable_experience':
+                        '保持本轮启用工位的照明' if case=='opposite' else EDIT_RULE})
+    except Exception as exc:
+        from evolvmem.experience_v2.gate.review_inbox import ReviewInboxError
+        assert isinstance(exc,ReviewInboxError)
+        if case in ('budget','timeout'):
+            assert exc.code=='review_edit_verification_unavailable'
+        else:
+            assert exc.status==409 and case=='protected_while_judging'
+        c.rollback()
+        assert dict(c.execute('SELECT uid,state FROM experience_proposals'))=={
+            edited:'review',old_peer:'review',target:'review'}
+        assert 'judge' in calls
+        return
+    assert case not in ('budget','timeout')
+    state,target_note=c.execute('SELECT state,merged_into_uid FROM experience_proposals WHERE uid=%s',(target,)).fetchone()
+    assert c.execute('SELECT state FROM experience_proposals WHERE uid=%s',(old_peer,)).fetchone()[0]=='review'
+    if case=='both_targets':
+        assert result['state']=='merged' and result['note']['id']==existing and (state,target_note)==('merged',existing)
+        assert c.execute('SELECT count(*) FROM experience_notes').fetchone()[0]==1
+    else:
+        assert (state,target_note)==('review',None) and result['note']['solution']==final_text
+        if case=='protected_while_judging':
+            assert 'judge' in calls
+
