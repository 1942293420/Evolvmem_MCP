+            result=metered_llm(conn=conn,owner_id=owner,proposal_uid=uid,track=track,session_id=session,
+                stage='review_equivalence',model=model,messages=[{'role':'system','content':PROMPT},
+                {'role':'user','content':data}],max_output_tokens=300,budget=budget,transport=transport)
+            raw=result.text.strip()
+            fenced=re.fullmatch(r'```(?:json)?\s*([\s\S]*?)\s*```',raw,re.I)
+            obj=json.loads(fenced[1] if fenced else raw)
+        except (BudgetDeferred,LlmTransportError,ValueError,TypeError):
+            return None
+        if not isinstance(obj,dict) or not all(obj.get(k) is True for k in FACETS):
+            return None
+        score=obj.get('confidence')
+        if type(score) not in (int,float) or not 0.95<=score<=1:
+            return None
+        target_kind = 'note' if peer in note_scores else ('historical' if peer in historical else 'proposal')
+        return dict(key=key,representative=peer,target_kind=target_kind,
+                    challenger_key=current_key,call_id=result.call_id,similarity=candidates[peer],
+                    reason=str(obj.get('reason',''))[:200],confidence=score,model=model,tokens=result.total_tokens)
+    return None
