--- /dev/null
+++ b/tests/stage2/test_review_rule_groups.py
@@ -0,0 +1,275 @@
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+import uuid
+
+import psycopg
+
+from evolvmem.experience_v2.gate import review_deduplication as g
+from evolvmem.experience_v2.gate.review_inbox import ReviewInboxService, ReviewInboxError
+from evolvmem.experience_v2.schema import apply_experience_migrations
+
+SECRET = 'review-rule-regression'
+
+
+class _DeterministicEmbedder:
+    def encode_document(self,text):
+        return [0,0,1]
+
+
+def add(c, tag, *, owner='test-u', track='live', source='archive:1', session='s1', category='业务经验',
+        register=True, state='review', solution='实验结束后立即逐台关闭工位照明', rule='只操作本轮启用的实验工位'):
+    uid = 'prop-' + uuid.uuid4().hex
+    p = dict(op='add',problem='如何收尾',solution=solution,reusable_experience=rule,
+             kind='preference',scope={'platform':'DemoLab'},misbelief='',pinned=False,importance=5)
+    c.execute("""INSERT INTO experience_proposals(uid,owner_id,op,category,kind,problem,solution,
+        reusable_experience,scope,payload_json,evidence_json,source_kind,source_track,agent_client,model,actor_id,
+        session_id,request_id,state) VALUES(%s,%s,'add',%s,'preference',%s,%s,%s,'{"platform":"DemoLab"}','{}',
+        jsonb_build_array(jsonb_build_object('library','personal','source',%s::text,'event',11)),
+        'pipeline',%s,'client','model',%s,%s,%s,%s)""",
+        (uid,owner,category,p['problem'],solution,rule,source,track,owner,session,tag,state))
+    if register:
+        import json
+        g.register(c,uid,owner,p,'pipeline',session,json.dumps({'family':session,'events':{'11':'row'}}))
+    c.execute("""INSERT INTO proposal_decisions(decision_id,proposal_uid,layer,verdict,confidence,judge_model)
+        VALUES(%s,%s,'L0','pass',1,'rule')""", ('l0-'+uid,uid))
+    return uid
+
+
+def decide(c,uid,verdict='accept',edits=None):
+    return ReviewInboxService(ticket_secret=SECRET).decide(c,owner_id='test-u',reviewer_id='test-u',
+        proposal_uid=uid,user_verdict=verdict,edited_payload=edits,user_reason='duplicate' if verdict=='reject' else None)
+
+
+def rows(c):
+    return c.execute("""SELECT id,occurrence_count,jsonb_array_length(evidence) FROM experience_notes
+        WHERE owner_id='test-u' AND status='active' ORDER BY created_at""").fetchall()
+
+
+def test_independent_evidence_old_rows_and_tracks(pg_exp_schema):
+    c,_,_ = pg_exp_schema
+    apply_experience_migrations(c)
+    old = add(c,'legacy',register=False,solution='旧规程由管理员维持实验室照明')
+    a = add(c,'a',track='backfill',source='archive:20',session='one')
+    b = add(c,'b',track='live',source='archive:21',session='one',category='系统环境经验')
+    other_incident = add(c,'c',source='archive:22',session='two')
+    opposite = add(c,'d',solution='实验结束后禁止逐台关闭工位照明')
+    blocked = add(c,'e',state='rejected')
+    processing = add(c,'f',state='pending')
+    c.commit()
+    cards = c.execute(f"""SELECT p.uid,{g.group_size_expr()} FROM experience_proposals p
+        WHERE state='review' AND {g.representative_filter()}""").fetchall()
+    assert set(cards) == {(old,1),(min(b,other_incident),3),(opposite,1)}
+    decide(c,b)
+    notes = rows(c)
+    assert len(notes)==1 and notes[0][1:] == (2,2)
+    states = dict(c.execute('SELECT uid,state FROM experience_proposals').fetchall())
+    assert states == {old:'review',a:'merged',b:'accepted',other_incident:'merged',opposite:'review',
+                      blocked:'rejected',processing:'pending'}
+    assert c.execute('SELECT count(*) FROM review_decisions').fetchone()[0] == 1
+    assert c.execute('SELECT count(*) FROM experience_relations').fetchone()[0] == 2
+    assert g.member(c,'test-u',old) is None
+
+
+def test_edit_uses_final_content_and_keeps_old_members_open(pg_exp_schema):
+    c,_,_ = pg_exp_schema
+    apply_experience_migrations(c)
+    a,b = add(c,'a'), add(c,'b')
+    final = add(c,'c',solution='结束后保存列表')
+    decide(c,a,'edit_accept',{'solution':'结束后保存列表'})
+    assert dict(c.execute('SELECT uid,state FROM experience_proposals')) == {a:'accepted',b:'review',final:'merged'}
+    new = add(c,'d',solution='结束后保存列表',source='archive:2')
+    decide(c,new)
+    assert len(rows(c))==1 and rows(c)[0][1:] == (1,1)
+
+
+def test_new_source_links_after_value_gate_without_inflating_review_or_occurrences(pg_exp_schema,monkeypatch):
+    from evolvmem.experience_v2.gate.dedupe import run_l1_dedupe
+    from evolvmem.experience_v2.writer import ExperienceWriter,TicketIssuer
+
+    c,_,_=pg_exp_schema
+    apply_experience_migrations(c)
+    first=add(c,'approved')
+    target=decide(c,first)['note']['id']
+    monkeypatch.setenv('EVOLVMEM_CATEGORY_GATES_ENABLED','1')
+    def next_one(tag):
+        u=add(c,tag,session=tag,source='archive:'+tag)
+        result=run_l1_dedupe(c,u,embedder=_DeterministicEmbedder(),writer=ExperienceWriter(SECRET),
+            ticket_issuer=TicketIssuer(SECRET,gate_id='test'),defer_source_link=True)
+        assert result['check_after_value_gate']
+        return u
+    rejected=next_one('80')
+    c.execute("UPDATE experience_proposals SET state='rejected' WHERE uid=%s",(rejected,))
+    assert not g.link_approved(c,rejected)
+    fresh=next_one('81')
+    assert not g.link_approved(c,fresh)
+    c.execute("""INSERT INTO proposal_decisions(decision_id,proposal_uid,layer,verdict,confidence,judge_model)
+        VALUES(%s,%s,'L2b','pass',1,'value-gate')""",('value-'+fresh,fresh))
+    assert g.link_approved(c,fresh)
+    assert not g.link_approved(c,fresh)
+    assert rows(c)==[(target,1,1)]  # source association only; this added no verified occurrence
+    assert c.execute("SELECT state,merged_into_uid FROM experience_proposals WHERE uid=%s",(fresh,)).fetchone()==('merged',target)
+    assert c.execute('SELECT count(*) FROM review_decisions').fetchone()[0]==1
+
+
+def test_simultaneous_approvals_create_one_note(pg_exp_schema):
+    c,schema,dsn = pg_exp_schema
+    apply_experience_migrations(c)
+    a,b=add(c,'a'),add(c,'b',track='backfill')
+    c.commit()
+    barrier=Barrier(2)
+    def run(uid):
+        with psycopg.connect(dsn,options=f'-c search_path={schema},public -c lock_timeout=4s') as w:
+            barrier.wait(timeout=4)
+            try:
+                return decide(w,uid)['state']
+            except ReviewInboxError as exc:
+                assert exc.code=='proposal_already_reviewed'
+                return 'closed'
+    with ThreadPoolExecutor(2) as pool:
+        assert set(pool.map(run,(a,b)))=={'accepted','closed'}
+    assert len(rows(c))==1
+    assert c.execute('SELECT count(*) FROM review_decisions').fetchone()[0]==1
+
+
+def test_cutover_attaches_only_fresh_members_to_one_existing_card(pg_exp_schema):
+    c,_,_=pg_exp_schema
+    apply_experience_migrations(c)
+    old1=add(c,'old1',register=False)
+    old2=add(c,'old2',register=False)
+    new=add(c,'new')
+    c.commit()
+    head=min(old1,old2)
+    other=max(old1,old2)
+    assert set(c.execute(f"SELECT p.uid,{g.group_size_expr()} FROM experience_proposals p WHERE {g.representative_filter()}"))=={(head,2),(other,1)}
+    try:
+        decide(c,new)
+    except ReviewInboxError as exc:
+        assert exc.code=='review_group_representative_required'
+    else:
+        raise AssertionError('older review card owns the decision')
+    decide(c,head)
+    assert dict(c.execute('SELECT uid,state FROM experience_proposals'))=={head:'accepted',other:'review',new:'merged'}
+    assert c.execute('SELECT count(*) FROM experience_review_members').fetchone()[0]==1
+
+
+def test_historical_paraphrase_compares_directly_to_one_old_representative(pg_exp_schema,monkeypatch):
+    import json
+    from types import SimpleNamespace as S
+    from evolvmem.experience_v2.gate import review_equivalence
+    from evolvmem.experience_v2.gate.dedupe import run_l1_dedupe,to_unit_vec768_literal
+    from evolvmem.experience_v2.writer import ExperienceWriter,TicketIssuer
+
+    c,_,_=pg_exp_schema
+    apply_experience_migrations(c)
+    old=[add(c,'older-'+str(n),register=False) for n in range(2)]
+    vec=to_unit_vec768_literal([0,0,1])
