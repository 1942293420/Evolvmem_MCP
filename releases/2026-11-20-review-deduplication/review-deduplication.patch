+
+
+def _compatible_duplicate(data, judgment):
+    target = judgment.get('incumbent') or {}
+    return (judgment.get('valid_judgment', True) and judgment['relation'] == 'duplicate'
+            and all(data.get(field) == target.get(field) for field in ('kind','scope'))
+            and (data.get('misbelief') or '') == (target.get('misbelief') or ''))
