+test('inbox uses actionable server totals, allows stable paging, and refreshes both badges after a decision', async () => {
+  let accepted = false;
+  const calls = [];
+  const E = client(async (url, opts) => {
+    calls.push(url);
+    const query = url.split('?')[1] || '';
+    if (opts.method === 'POST') {
+      accepted = true;
+      return response(200, {ok:true});
+    }
+    if (url.includes('/sources')) {
+      const next = query.includes('after=head-source');
+      return response(200,{ok:true,next_cursor:next ? null : 'head-source',
+        items:[{uid:next?'other-source':'head-source',source_track:next?'backfill':'live',category:'业务经验',
+          session_id:'session-'+(next?'B':'A'),evidence:[{ref:next?'archive:22#3':'archive:11#2',quote:'核对原始证据'}]}]});
+    }
+    if (url.includes('/guidance')) return response(200, {ok:true,items:[]});
+    const reviewed = query.includes('view=reviewed'), next = query.includes('after=head');
+    const uid = reviewed ? 'head' : next ? 'tail' : accepted ? 'replacement' : 'head';
+    return response(200, {ok:true,shadow_mode:true,counts:{live:accepted ? 72 : 73,backfill:3},
+      next_cursor: next || reviewed ? null : uid, items:[{uid, state:reviewed ? 'accepted' : 'review',
+        source_track:'live',category:'业务经验',problem:uid,group_size:2,
+        review: reviewed ? {user_verdict:'accept'} : null}]});
+  });
+  E.state.apiMode='live'; E.state.ownerId=E.state.libraryCtx='owner'; E.state.route='review-inbox';
+  E.state.liveMetrics={pending_live:900,pending_backfill:20,active_notes:12};
+  await E.api.loadInbox();
+  assert.match(E.views['review-inbox'](), /新会话队列 \(73\)/);
+  assert.match(E.views['review-inbox'](), /旧聊天回填 \(3\)/);
+  assert.match(E.views['review-inbox'](), /同一规则 · 2 条提案/);
+  assert.match(E.views['review-inbox'](), /data-sub="interceptions">门控拦截/);
+  assert.match(E.renderTopNav(), />76<\/span>/);
+  E.applyAction('review-sources-toggle', {uid:'head'});
+  await new Promise(resolve => setImmediate(resolve));
+  assert.match(E.views['review-inbox'](), /data-ref="archive:11#2"/);
+  E.applyAction('review-sources-more', {uid:'head'});
+  await new Promise(resolve => setImmediate(resolve));
+  assert.match(E.views['review-inbox'](), /other-source/);
+  assert.match(E.views['review-inbox'](), /data-ref="archive:22#3"/);
+  E.applyAction('inbox-next', {});
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(E.state.proposals[0].uid, 'tail');
+  E.applyAction('inbox-prev', {});
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(E.state.proposals[0].uid, 'head');
+  await E.api.decideProposal('head','accept',null,null);
+  assert.equal(E.state.proposals[0].uid,'replacement');
+  assert.match(E.renderTopNav(), />75<\/span>/);
+  assert.match(E.views['review-inbox'](), /新会话队列 \(72\)/);
+  E.applyAction('inbox-view', {view:'reviewed'});
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(E.state.proposals[0].status,'approved');
+  assert.doesNotMatch(E.views['review-inbox'](), /data-act="approve-prop"/);
+  assert.ok(calls.some(url=>url.includes('after=head')));
+  assert.ok(calls.every(url=>!url.includes('include_decided')));
