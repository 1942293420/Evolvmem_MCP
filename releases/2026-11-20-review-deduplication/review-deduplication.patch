+            text = ' '.join(row[:3])
+            return set(re.findall(r'[A-Za-z][A-Za-z0-9_.-]*|[0-9]+(?:[.:%/-][0-9]+)*',text))
+        if identifiers(fields)!=identifiers(other):
+            continue
+        names = ('problem','solution','reusable_experience','scope','kind','misbelief')
+        data=json.dumps({'left':dict(zip(names,fields)),'right':dict(zip(names,other))},
+                        ensure_ascii=False,separators=(',',':'))
