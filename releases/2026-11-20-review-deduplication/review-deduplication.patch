+"""Exercise the live and backfill transaction boundaries against actual PostgreSQL locks."""
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime, timezone
+from threading import Barrier
+from types import SimpleNamespace
+
+import psycopg
+import pytest
+
+from evolvmem.experience_v2.backfill.runner import BackfillRunner
+from evolvmem.experience_v2.pipeline import live_worker
+
+
+def test_reverse_rule_lock_restarts_the_whole_live_or_backfill_source(pg_exp_schema, monkeypatch):
+    setup, schema, dsn = pg_exp_schema
+    setup.execute("CREATE TABLE effects(source text, phase text, PRIMARY KEY(source, phase))")
+    setup.commit()
+    barrier = Barrier(2)
+    attempts = {}
+    now = datetime.now(timezone.utc)
+
+    class Scheduler:
+        def process_session_if_ready(self, conn, source, **kwargs):
+            attempts[source] = attempts.get(source, 0) + 1
+            first, second = ('A', 'B') if source == 'archive:live' else ('B', 'A')
+            conn.execute("INSERT INTO effects VALUES(%s, 'started')", (source,))
+            conn.execute("SELECT pg_advisory_xact_lock(hashtextextended(%s,0))", (first,))
+            if attempts[source] == 1:
+                barrier.wait(timeout=8)
+            conn.execute("SELECT pg_advisory_xact_lock(hashtextextended(%s,0))", (second,))
+            conn.execute("INSERT INTO effects VALUES(%s, 'proposal')", (source,))
+            return {'status': 'completed', 'proposals': 1}
+
+    scheduler = Scheduler()
+    queue = SimpleNamespace(
+        check_run_gate=lambda **kw: {'allowed': True},
+        claim_next_jobs=lambda conn, **kw: [{'job_id': 'job', 'source_ref': 'archive:backfill'}],
+        mark_job_result=lambda conn, **kw: conn.execute("INSERT INTO effects VALUES('archive:backfill', %s)", (kw['status'],)),
+    )
+    runner = object.__new__(BackfillRunner)
+    runner.policy, runner.queue, runner.scheduler = None, queue, scheduler
+    summary = SimpleNamespace(source_ref='archive:live', session_id='live', library='personal', history_owner_id='owner', source_digest='digest')
+    source = SimpleNamespace(summary=summary, family='family', native_upload=False, immutable=True, created=now)
+    session = SimpleNamespace(summary=summary, records=[object()])
+    reader = SimpleNamespace(get_session=lambda ref: session)
+    monkeypatch.setattr(live_worker.live_sources, 'claim', lambda *args: True)
+    monkeypatch.setattr(live_worker.live_sources, 'complete', lambda conn, *args:
+                        conn.execute("INSERT INTO effects VALUES('archive:live', 'completed')"))
+
+    def run(track):
+        with psycopg.connect(dsn, autocommit=track == 'live', options=f'-c search_path={schema},public -c lock_timeout=6s') as worker:
+            if track == 'backfill':
+                return runner.run_queued_batch(worker, scope_kind='project', scope_value='p')['results'][0]['result']['status']
+            return live_worker._advance_source(worker, scheduler, reader, 'owner', 'v', source, [], now)['status']
+
+    with ThreadPoolExecutor(2) as pool:
+        assert list(pool.map(run, ['live','backfill'])) == ['completed', 'completed']
+    assert sorted(attempts.values()) == [1, 2]
+    assert set(setup.execute('SELECT source,phase FROM effects')) == {
+        (source, phase) for source in attempts for phase in ('started', 'proposal', 'completed')}
+
+
+def test_source_retry_is_bounded_and_keeps_other_errors(pg_exp_schema):
+    from evolvmem.experience_v2.pipeline.worker_transaction import run_source_transaction
+    conn, _, _ = pg_exp_schema
+    conn.execute('CREATE TABLE attempts(value int)')
+    for error, expected in [(psycopg.errors.DeadlockDetected, 3), (ValueError, 1)]:
+        calls = []
+        def fail():
+            calls.append(1)
+            conn.execute('INSERT INTO attempts VALUES (1)')
+            raise error('fixture')
+        with pytest.raises(error):
+            run_source_transaction(conn, fail)
+        assert len(calls) == expected
+        assert conn.execute('SELECT COUNT(*) FROM attempts').fetchone()[0] == 0
+
