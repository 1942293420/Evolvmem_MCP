+"""Review candidates must be grounded in messages authored in this conversation."""
+import json
+
+from evolvmem.experience_v2.pipeline.events import parse_session_events
+from evolvmem.experience_v2.pipeline.extract import _resolve_verified_evidence
+from evolvmem.experience_v2.pipeline.history_reader import HistoryRawRecord, HistorySession, HistorySessionSummary
+from evolvmem.experience_v2.pipeline.moments import detect_key_moments
+
+
+def message(text, role="user"):
+    return {"type": "response_item", "payload": {"type": "message", "role": role, "content": [{"text": text}]}}
+
+
+def parse(rows):
+    summary = HistorySessionSummary("t", "codex", "codex-jsonl", "", "archive:t", "personal", "t", "")
+    records = tuple(HistoryRawRecord(i, "", "", row) for i, row in enumerate(rows, 1))
+    raw = "\n".join(json.dumps(row) for row in rows).encode()
+    return parse_session_events(HistorySession(summary, records, raw, True))
+
+
+RULES = "# AGENTS.md instructions for project\n<INSTRUCTIONS>\nAlways use DemoLab fixtures.\n</INSTRUCTIONS>"
+ENV = "<environment_context>wrong cwd</environment_context>"
+REVIEW_PROMPT = (
+    "The following is the Codex agent history whose request action you are assessing. "
+    "Synthetic review fixture:\n>>> RETAINED USER INSTRUCTIONS\nActually use DemoLab."
+)
+
+
+def test_internal_review_cannot_emit_user_or_tool_experiences():
+    meta = {"type": "session_meta", "payload": {"source": {"subagent": {"other": "guardian"}}}}
+    failure = {"type": "response_item", "payload": {"type": "function_call_output", "output": "ValueError"}}
+    parsed = parse([meta, message(RULES), message("wrong, use next day"), failure])
+    assert not detect_key_moments(parsed)
+
+
+def test_review_transcript_without_header_and_wrappers_supply_no_training_text():
+    parsed = parse([message(RULES), message(ENV), message(REVIEW_PROMPT)])
+    assert not parsed.user_intents
+    assert not any(e.get("text") for e in parsed.events)
+
+
+def test_real_correction_after_injected_message_has_own_evidence_and_content():
+    rows = [message(RULES), {"type": "turn_context"}, message(ENV), message("不对，光谱数据要按波长升序排列。")]
+    parsed = parse(rows)
+    [moment] = detect_key_moments(parsed)
+    assert moment.kind == "user_correction"
+    assert "波长升序" in moment.snippet_text
+    assert "DemoLab" not in moment.snippet_text
+    assert "cwd" not in moment.snippet_text
+    for native_positions in (False, True):
+        [pointer] = _resolve_verified_evidence(moment, library="personal", valid_record_indices=[1, 2, 3, 4],
+                                              native_positions=native_positions)
+        assert pointer["line_no"] == 4
+
+
+def test_injection_and_real_request_in_same_message_are_separated():
+    parsed = parse([message(RULES + "\n" + ENV + "\n以后默认导出实验读数的中位数。")])
+    [moment] = detect_key_moments(parsed)
+    assert "中位数" in moment.snippet_text
+    assert "fixtures" not in moment.snippet_text
+
+
+def test_neutral_reference_and_user_fork_still_work():
+    rows = [
+        {"type": "session_meta", "payload": {"forked_from_id": "parent"}},
+        {"type": "session_meta", "payload": {"source": {"subagent": {"other": "guardian"}}}},
+        message("请修改 AGENTS.md，实际规则不对，DemoLab 实验后关闭本轮启用的工位照明。"),
+    ]
+    assert detect_key_moments(parse(rows))[0].kind == "user_correction"
+
+
+def test_bare_disagreement_is_not_evidence_for_adjacent_rules():
+    assert not detect_key_moments(parse([message(RULES), message("不对。")]))
+
+
+def test_long_correction_keeps_the_statement_at_its_evidence_line():
+    original = "背景情况。" * 150 + "不对，导出值应该保留四位小数。"
+    [moment] = detect_key_moments(parse([message(original)]))
+    assert "导出值应该保留四位小数" in moment.snippet_text
+
+
+def test_working_subagent_keeps_tools_without_learning_delegated_user_preferences():
+    rows = [
+        {"type": "session_meta", "payload": {"source": {"subagent": {"thread_spawn": {"parent_thread_id": "parent"}}}}},
+        message("不对，以后默认给这个代理传 DemoLab 固定模板。"),
+        {"type": "response_item", "payload": {"type": "function_call_output", "output": "ValueError"}},
+        {"type": "response_item", "payload": {"type": "function_call_output", "output": "exit_code: 0"}},
+    ]
+    parsed = parse(rows)
+    [moment] = detect_key_moments(parsed)
+    assert moment.kind == "fail_to_success"
+    assert not parsed.user_intents
+    assert "DemoLab" not in moment.snippet_text
+    pointers = _resolve_verified_evidence(moment, library="personal", valid_record_indices=[1, 2, 3, 4],
+                                          native_positions=True)
+    assert [p["line_no"] for p in pointers] == [3, 4]
+
+
+def test_kimi_and_dsh_native_user_evidence_preserves_existing_incremental_cursor():
+    from evolvmem.experience_v2.pipeline.scheduler import _slice_delta_parsed
+    def dsh_message(text, source="user"):
+        return {"type": "user/message", "data": {"role": "user", "source": {"kind": source},
+                "content": [{"type": "text", "text": text}]}}
+    dsh_rows = [{"type": "session"}, dsh_message("ordinary task"),
