+@pytest.mark.parametrize(('changed_scope', 'expected'), [(False, True), (True, False)])
+def test_l3_duplicate_target_proof_binds_reviewed_content_and_scope(pg_exp_schema, monkeypatch, changed_scope, expected):
+    import json
+    from tests.stage2.test_review_rule_groups import add, decide
+    from evolvmem.experience_v2.gate import reconcile
