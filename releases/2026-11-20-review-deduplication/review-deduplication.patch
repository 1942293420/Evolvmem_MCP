+    wanted = [_seed_proposal(conn, state='review', problem=f'Unique scenario {i}') for i in range(4)]
+    for state in ('pending', 'rejected', 'quarantined', 'accepted', 'merged'):
+        _seed_proposal(conn, state=state)
+    legacy = _seed_proposal(conn, state='review')
+    conn.execute("UPDATE experience_proposals SET source_kind='legacy' WHERE uid=%s", (legacy,))
+    _seed_proposal(conn, owner_id='elsewhere', state='review')
+    backfill = _seed_proposal(conn, source_track='backfill', state='review')
+    conn.execute("UPDATE experience_proposals SET created_at='2026-11-05T12:00:00Z' WHERE uid=ANY(%s)", (wanted,))
+    first = svc.list_inbox(conn, owner_id=owner, limit=2)
+    assert first['counts'] == {'live': 4, 'backfill': 1}
+    assert [item['uid'] for item in first['items']] == sorted(wanted)[:2]
+    boundary = first['next_cursor']
+    # The boundary may be decided while the next page is loading.
+    svc.decide(conn, owner_id=owner, reviewer_id=owner, proposal_uid=boundary,
+               user_verdict='reject', user_reason='other')
+    rest = svc.list_inbox(conn, owner_id=owner, limit=2, after=boundary)
+    assert [item['uid'] for item in rest['items']] == sorted(wanted)[2:]
+    assert rest['next_cursor'] is None
+    assert rest['counts'] == {'live': 3, 'backfill': 1}
+    with pytest.raises(ReviewInboxError):
+        svc.list_inbox(conn, owner_id=owner, after=backfill)
+    history = svc.list_inbox(conn, owner_id=owner, reviewed_only=True)
+    assert [item['uid'] for item in history['items']] == [boundary]
+    earlier = next(uid for uid in wanted if uid != boundary)
+    svc.decide(conn, owner_id=owner, reviewer_id=owner, proposal_uid=earlier,
+               user_verdict='reject', user_reason='other')
+    conn.execute("UPDATE review_decisions SET created_at=now() - interval '2 days' WHERE proposal_uid=%s", (earlier,))
+    history = svc.list_inbox(conn, owner_id=owner, reviewed_only=True, limit=1)
