+    if judgment['relation'] == 'duplicate' and not _compatible_duplicate(data, judgment):
+        return False
+    owner, key = data['owner_id'], mark[0]
+    if not groups.try_key(conn, owner, key):
+        return False
+    # A paraphrased member points at a representative with different content.
+    # Its existing equivalence proof stays available to the human reviewer.
+    if _judged_key(data) != key:
+        return False
+    fields = (data['problem'], data['solution'], data['reusable_experience'])
+    existing = groups.matching_notes(conn, owner, key, fields, data['embedding'])
+    if existing and (judgment['relation'] != 'duplicate' or judgment['target_note_id'] != existing[0]):
