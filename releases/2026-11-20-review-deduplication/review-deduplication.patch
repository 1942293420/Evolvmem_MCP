diff --git a/evolvmem/experience_v2/pipeline/worker_transaction.py b/evolvmem/experience_v2/pipeline/worker_transaction.py
new file mode 100644
index 0000000000000000000000000000000000000000..7bc1b9287d660e352c0d576f1cbb1b73df30ce5c
--- /dev/null
+++ b/evolvmem/experience_v2/pipeline/worker_transaction.py
@@ -0,0 +1,21 @@
+"""Keep all database effects for a source inside the same retry boundary."""
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import TypeVar
+
+from psycopg.errors import DeadlockDetected
+
+T = TypeVar('T')
+
+
+def run_source_transaction(conn, process: Callable[[], T]) -> T:
+    # The context manager rolls back the failed transaction (or its source savepoint)
+    # before another attempt reads source state or makes any new writes.
+    for attempt in range(1, 4):
+        try:
+            with conn.transaction():
+                return process()
+        except DeadlockDetected:
+            if attempt == 3:
+                raise
