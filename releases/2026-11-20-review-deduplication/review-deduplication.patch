+    if judgment['relation'] == 'duplicate':
+        current = conn.execute("""SELECT problem,solution,reusable_experience,scope,kind,misbelief
+            FROM experience_notes WHERE id=%s AND owner_id=%s AND deleted_at IS NULL
+            AND status='active' AND NOT pinned AND importance<8 FOR UPDATE SKIP LOCKED""",
+            (judgment['target_note_id'],owner)).fetchone()
+        return bool(current and groups.rule_key(*current) == _judged_key(judgment['incumbent']))
+    return True
