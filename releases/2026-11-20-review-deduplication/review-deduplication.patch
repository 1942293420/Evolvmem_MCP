+    next_item={'source':'archive:2','event':11}
+    second=g.stable_source(summary,[next_item],raw,'c'*64)
+    diff=g.stable_source(summary,[next_item],{11:S(raw_event={'event':'y'})},'c'*64)
+    assert g.evidence_key(item,first)==g.evidence_key(next_item,second)
+    assert g.evidence_key(item,first)!=g.evidence_key(next_item,diff)
+    assert not g.stable_source(summary,[next_item],raw,h2)
+
+
+def test_competing_group_confirmation_never_waits_for_second_key(pg_exp_schema):
+    c,schema,dsn=pg_exp_schema
+    apply_experience_migrations(c)
+    barrier=Barrier(2)
+    again=Barrier(2)
+    def run(pair):
+        with psycopg.connect(dsn,options=f'-c search_path={schema},public -c lock_timeout=2s') as other:
+            g.lock_keys(other,'owner',[pair[0]])
+            barrier.wait(timeout=4)
+            won=g.try_key(other,'owner',pair[1])
+            again.wait(timeout=4)
+            return won
+    with ThreadPoolExecutor(2) as pool:
+        assert list(pool.map(run,[('first','second'),('second','first')]))==[False,False]
