+            if not isinstance(value,str):
+                return False
+            parts = [s for s in re.split(r'[/、,，或和]',value.replace('任务','')) if s]
+            return bool(parts) and all(s in t for s in parts for t in texts)
+        if any(not scope_repeated(k,(a if k in a else b)[k]) for k in a.keys() ^ b.keys()):
+            continue
+        guards = (r'禁止|不得|不应|不可|不能|不允许|切勿|严禁|不要|不关闭|不关',
+                  r'除非|例外|除外|except|unless')
+        if any(bool(re.search(pattern,texts[0],re.I)) != bool(re.search(pattern,texts[1],re.I)) for pattern in guards):
+            continue
