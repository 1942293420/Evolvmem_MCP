+def test_concurrent_auto_l3_writes_one_note_and_preserves_the_other_proposal(pg_exp_schema, monkeypatch):
+    from tests.stage2.test_review_rule_groups import add
+    from evolvmem.experience_v2.gate import reconcile
+    from evolvmem.experience_v2.schema import apply_experience_migrations
+    from evolvmem.experience_v2.writer import ExperienceWriter, TicketIssuer
+
+    setup, schema, dsn = pg_exp_schema
+    apply_experience_migrations(setup)
+    first, second = add(setup, 'l3-first'), add(setup, 'l3-second', track='backfill')
+    setup.commit()
+    barrier = Barrier(2)
+    def judge(*args, **kwargs):
+        # Both adjudications observed the same snapshot before either started writing.
+        barrier.wait(timeout=8)
+        return dict(relation=None, target_note_id=None, confidence=1., reason='new', calls_used=0,
+                    candidates_checked=0, tokens_used=0)
+    monkeypatch.setattr(reconcile, 'assess_l3_shadow', judge)
+    monkeypatch.setattr(reconcile.category_policy, 'admission_mode', lambda *args, **kw: 'auto')
+    def run(uid):
+        with psycopg.connect(dsn, options=f'-c search_path={schema},public -c lock_timeout=5s') as worker:
+            return reconcile.run_l3_reconcile_gate(worker, uid, judge_model='judge',
+                judge_transport=None, writer=ExperienceWriter('test'), ticket_issuer=TicketIssuer('test', gate_id='L3'),
+                gate_mode='auto')
+    with ThreadPoolExecutor(2) as pool:
+        list(pool.map(run, [first, second]))
+    assert setup.execute('SELECT COUNT(*) FROM experience_notes').fetchone()[0] == 1
+    assert sorted(row[0] for row in setup.execute('SELECT state FROM experience_proposals')) == ['accepted', 'review']
+    assert setup.execute("SELECT COUNT(*) FROM proposal_decisions WHERE layer='L3'").fetchone()[0] == 2
+
+
+@pytest.mark.parametrize("registered", [False, True])
+def test_reverse_batch_review_serializes_in_both_generations(pg_exp_schema, registered):
+    from tests.stage2.test_review_rule_groups import add, SECRET
+    from evolvmem.experience_v2.gate.review_inbox import ReviewInboxError, ReviewInboxService
+    from evolvmem.experience_v2.schema import apply_experience_migrations
+
+    setup, schema, dsn = pg_exp_schema
+    apply_experience_migrations(setup)
+    a = add(setup, 'batch-A', register=registered, solution='A')
+    b = add(setup, 'batch-B', register=registered, solution='B')
+    setup.commit()
+    barrier = Barrier(2)
+    def decide(ids):
+        with psycopg.connect(dsn, options=f'-c search_path={schema},public -c lock_timeout=5s') as worker:
+            barrier.wait(timeout=8)
+            try:
+                result = ReviewInboxService(ticket_secret=SECRET).batch_decide(
+                    worker,owner_id='test-u',reviewer_id='test-u',proposal_uids=ids,user_verdict='accept')
+                assert [item['proposal_uid'] for item in result['results']] == ids
+                return 'completed'
+            except ReviewInboxError as err:
+                worker.rollback()
+                return err.code
+    with ThreadPoolExecutor(2) as pool:
+        results = list(pool.map(decide, [[a,b], [b,a]]))
+    assert sorted(results) == ['completed', 'proposal_already_reviewed']
+    assert setup.execute('SELECT COUNT(*) FROM experience_notes').fetchone()[0] == 2
+    assert setup.execute('SELECT COUNT(*) FROM review_decisions').fetchone()[0] == 2
+
