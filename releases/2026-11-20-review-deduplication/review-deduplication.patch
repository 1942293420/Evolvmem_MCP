+def test_replayed_reject_or_accept_requires_same_verified_source(pg_exp_schema):
+    import pytest
+    c,_,_=pg_exp_schema
+    apply_experience_migrations(c)
+    for suffix,verdict in [('origin-a','reject'),('origin-b','accept')]:
+        a=add(c,'a'+suffix,solution=suffix)
+        b=add(c,'b'+suffix,solution=suffix)
+        decide(c,a,verdict)
+        if verdict=='reject':
+            for stale in ('accept','edit_accept','reject'):
+                with pytest.raises(ReviewInboxError) as err:
+                    decide(c,b,stale)
+                assert err.value.code=='proposal_already_reviewed'
+        repeat=add(c,'repeat'+suffix,source='archive:99',solution=suffix)
+        new_incident=add(c,'new'+suffix,source='archive:100',session='another',solution=suffix)
+        for uid,expected in [(repeat,True),(new_incident,False)]:
+            ev=c.execute('SELECT evidence_json FROM experience_proposals WHERE uid=%s',(uid,)).fetchone()[0]
+            assert bool(g.reuse_decision(c,'test-u',uid,g.member(c,'test-u',uid),ev))==expected
+        assert c.execute('SELECT state FROM experience_proposals WHERE uid=%s',(repeat,)).fetchone()[0]==('rejected' if verdict=='reject' else 'merged')
+    assert c.execute('SELECT count(*) FROM review_decisions').fetchone()[0]==2
+    assert rows(c)[0][1:]==(1,1)
