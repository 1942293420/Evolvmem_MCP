+    fresh=add(c,'paraphrase',solution='实验一结束便逐一熄灭工位灯光',rule='只动本次实际启用的实验工位')
+    monkeypatch.setattr(review_equivalence,'metered_llm',lambda **kw:S(text=json.dumps(
+        {**dict.fromkeys(review_equivalence.FACETS,True),'confidence':.99,'reason':'synthetic regression'}),
+        total_tokens=20,call_id=1))
+    run_l1_dedupe(c,fresh,embedder=_DeterministicEmbedder(),writer=ExperienceWriter(SECRET),
+        ticket_issuer=TicketIssuer(SECRET,gate_id='test'),judge_model='independent',judge_transport=object())
+    anchor,proof=c.execute('SELECT historical_anchor,group_proof FROM experience_review_members WHERE proposal_uid=%s',(fresh,)).fetchone()
+    assert anchor in old and proof['target_kind']=='historical'
+    assert set(c.execute(f"SELECT p.uid,{g.group_size_expr()} FROM experience_proposals p WHERE {g.representative_filter()}"))=={
+        (uid,2 if uid==anchor else 1) for uid in old}
+    decide(c,anchor)
+    assert c.execute('SELECT count(*) FROM experience_review_members').fetchone()[0]==1
+    assert c.execute('SELECT state FROM experience_proposals WHERE uid=%s',(fresh,)).fetchone()[0]=='merged'
+    assert c.execute("SELECT count(*) FROM experience_proposals WHERE uid=ANY(%s) AND state='review'",(old,)).fetchone()[0]==1
+
