+-- Membership starts with proposal creation by the new writer. Never backfill this registry.
+CREATE TABLE IF NOT EXISTS experience_review_members (
+    proposal_uid TEXT PRIMARY KEY REFERENCES experience_proposals(uid),
+    owner_id TEXT NOT NULL,
+    rule_key TEXT NOT NULL,
+    content_key TEXT NOT NULL,
+    group_proof JSONB,
+    historical_anchor TEXT REFERENCES experience_proposals(uid),
+    closed_with TEXT,
+    note_id TEXT,
+    evidence_source TEXT NOT NULL DEFAULT ''
+);
+CREATE INDEX IF NOT EXISTS idx_experience_review_members_rule
+    ON experience_review_members(owner_id, rule_key, proposal_uid);
+CREATE INDEX IF NOT EXISTS idx_experience_review_members_anchor
+    ON experience_review_members(owner_id,historical_anchor) WHERE historical_anchor IS NOT NULL;
+DO $$ BEGIN
+    IF EXISTS (SELECT FROM pg_roles WHERE rolname='evolvmem_experience_coordinator') THEN
+        GRANT SELECT,INSERT,UPDATE ON experience_review_members TO evolvmem_experience_coordinator;
+    END IF;
+    IF EXISTS (SELECT FROM pg_roles WHERE rolname='evolvmem_experience_reader') THEN
+        GRANT SELECT ON experience_review_members TO evolvmem_experience_reader;
+    END IF;
+END $$;
