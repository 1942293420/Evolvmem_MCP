+
+    setup, _, _ = pg_exp_schema
+    apply_experience_migrations(setup)
+    first = add(setup, 'target')
+    decide(setup, first)
+    target, reusable = setup.execute('SELECT id,reusable_experience FROM experience_notes').fetchone()
+    second = add(setup, 'next', solution='实验结束时立即逐一熄灭工位灯', session='different')
+    if changed_scope:
+        setup.execute("UPDATE experience_proposals SET scope='{}' WHERE uid=%s", (second,))
+    def transport(model, messages, limit):
+        prompt = messages[1]['content']
+        assert f'R:{reusable}' in prompt.split('候选旧经验:')[1]
+        assert 'kind=preference' in prompt and '误区:' in prompt
+        return {'text': json.dumps(dict(relation='duplicate', target_note_id=target, confidence=.98, reason='same'))}
+    monkeypatch.setattr(reconcile.category_policy, 'admission_mode', lambda *args, **kw: 'review')
+    reconcile.run_l3_reconcile_gate(setup, second, judge_model='judge', judge_transport=transport,
+        writer=ExperienceWriter('test'), ticket_issuer=TicketIssuer('test', gate_id='L3'), gate_mode='review')
+    meta = setup.execute("SELECT meta_json FROM proposal_decisions WHERE proposal_uid=%s AND layer='L3'", (second,)).fetchone()[0]
+    assert bool(meta.get('review_target_key')) is expected
