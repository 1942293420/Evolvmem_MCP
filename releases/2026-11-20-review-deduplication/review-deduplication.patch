diff --git a/evolvmem/experience_v2/gate/review_deduplication.py b/evolvmem/experience_v2/gate/review_deduplication.py
new file mode 100644
index 0000000000000000000000000000000000000000..fe5d0abe57f96d675dcb1cc82bc5627cf5bc0b85
--- /dev/null
+++ b/evolvmem/experience_v2/gate/review_deduplication.py
@@ -0,0 +1,400 @@
+"""Deduplicate newly submitted, independently reviewable add proposals within an owner."""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import unicodedata
+
+
+def _plain(text):
+    # Keep operators, negatives, numbers, code identifiers and clause order significant.
+    normalized = unicodedata.normalize('NFC', text or '').strip()
+    if not any(mark in normalized for mark in ('`', '"', "'", '\\', '/', '=')):
+        normalized = re.sub(r'[ \t]+', ' ', normalized).rstrip('。')
+        normalized = normalized.replace('立刻', '立即').replace('用毕', '使用完毕')
+    return normalized
+
+
+def rule_key(problem, solution, reusable, scope, kind, misbelief):
+    payload = [kind, scope or {}, *(_plain(s) for s in (problem, solution, reusable, misbelief))]
+    return hashlib.sha256(json.dumps(payload, ensure_ascii=False, sort_keys=True,
+                                     separators=(',', ':')).encode()).hexdigest()
+
+
+def stable_source(summary, evidence, records, verified_digest):
+    """Alias a native row only with the same verified upload family and event content."""
+    match = re.fullmatch(r'([a-f0-9]{64}):([a-f0-9]{64})', summary.external_session_id)
+    if not match or not summary.logical_session_id or match[2] != verified_digest:
+        return ''
+    identity = [summary.adapter,summary.project,match[1],summary.logical_session_id]
+    events = {}
+    for item in evidence:
+        index = item.get('line_no',item.get('event'))
+        if item.get('source') != summary.source_ref or index not in records:
+            continue
+        raw = json.dumps(records[index].raw_event,ensure_ascii=False,sort_keys=True,separators=(',',':'))
+        events[str(index)] = hashlib.sha256(raw.encode()).hexdigest()
+    return json.dumps({'family':identity,'events':events},ensure_ascii=False) if events else ''
+
+
+def register(conn, uid, owner, payload, source_kind, session_id, provenance=None):
+    if (source_kind not in ('pipeline', 'agent') or payload['op'] != 'add'
+            or payload['pinned'] or payload['importance'] >= 8 or payload['kind'] == 'habit'):
+        return
+    key = rule_key(payload['problem'], payload['solution'], payload['reusable_experience'],
+                   payload['scope'], payload['kind'], payload['misbelief'])
+    # The session ID comes from the trusted pipeline for archive alias normalization.
+    trusted_source = (provenance or '') if source_kind == 'pipeline' else ''
+    historical = None
+    for row in conn.execute(f"""SELECT p.uid,p.problem,p.solution,p.reusable_experience,p.scope,p.kind,p.misbelief
+        FROM experience_proposals p WHERE p.owner_id=%s AND p.uid<>%s AND p.source_kind IN ('pipeline','agent')
+        AND p.op='add' AND NOT p.pinned AND p.importance<8 AND p.kind<>'habit' AND {_eligible('p')}
+        AND NOT EXISTS (SELECT FROM experience_review_members m WHERE m.proposal_uid=p.uid)
+        AND (p.problem=%s OR p.solution=%s OR p.reusable_experience=%s)
+        ORDER BY p.source_track<>'live',p.created_at,p.uid""",
+        (owner,uid,payload['problem'],payload['solution'],payload['reusable_experience'])):
+        if rule_key(*row[1:])==key:
+            historical=row[0]
+            break
+    conn.execute("""INSERT INTO experience_review_members(proposal_uid,owner_id,rule_key,content_key,evidence_source,historical_anchor)
+        VALUES(%s,%s,%s,%s,%s,%s)""", (uid, owner, key, key, trusted_source,historical))
+
+
+def member(conn, owner, uid):
+    return conn.execute("""SELECT rule_key,evidence_source,closed_with FROM experience_review_members
+        WHERE owner_id=%s AND proposal_uid=%s""", (owner, uid)).fetchone()
+
+
+def lock_keys(conn, owner, keys):
+    import time
+    expires = time.monotonic()+1.25
+    for key in sorted(set(filter(None, keys))):
+        while not try_key(conn,owner,key):
+            if time.monotonic() >= expires:
+                from evolvmem.experience_v2.gate.review_inbox import ReviewInboxError
+                raise ReviewInboxError('review_decision_busy',409)
+            time.sleep(0.025)
+
+
+def try_key(conn, owner, key):
+    return conn.execute('SELECT pg_try_advisory_xact_lock(hashtextextended(%s,0))',
+                        ('experience-review-rule:' + owner + ':' + key,)).fetchone()[0]
+
+
+def reuse_decision(conn, owner, uid, mark, evidence):
+    """Reuse a human decision only for identical, already verified observations."""
+    if not evidence or any(not e.get('source') or e.get('event',e.get('line_no')) is None for e in evidence):
+        return None
+    newest = conn.execute("""SELECT r.review_id,r.user_verdict,r.proposal_uid
+        FROM experience_review_members m JOIN review_decisions r ON r.proposal_uid=m.closed_with
+        WHERE m.owner_id=%s AND r.owner_id=m.owner_id AND (m.content_key=%s OR m.rule_key=%s)
+        ORDER BY r.created_at DESC,r.review_id DESC LIMIT 1""",(owner,mark[0],mark[0])).fetchone()
+    if not newest:
+        return None
+    rejected = newest[1]=='reject'
+    prior = conn.execute("""SELECT p.evidence_json,m.evidence_source,m.note_id,m.rule_key,m.content_key FROM experience_review_members m
+        JOIN experience_proposals p ON p.uid=m.proposal_uid AND m.owner_id=p.owner_id
+        WHERE m.owner_id=%s AND m.closed_with=%s AND p.state IN ('rejected','accepted','merged')
+        AND (m.rule_key=%s OR m.content_key=%s)""",
+        (owner,newest[2],mark[0],mark[0])).fetchall()
+    incoming = {evidence_key(e,mark[1]) for e in evidence}
+    matched = [(note,key,content_key) for items,src,note,key,content_key in prior
+               if incoming <= {evidence_key(e,src) for e in (items or [])}]
+    if not matched:
+        return None
+    note = None
+    if not rejected:
+        note = next((n for n,_,_ in matched if n), None)
+        active = conn.execute("""SELECT problem,solution,reusable_experience,scope,kind,misbelief
+            FROM experience_notes WHERE id=%s AND owner_id=%s AND status='active' AND deleted_at IS NULL
+            AND NOT pinned AND importance<8 FOR SHARE""",(note,owner)).fetchone()
+        if not active or not any(n==note and rule_key(*active) in (k,ck) for n,k,ck in matched):
+            return None
+    import uuid
+    decision = 'dec-repeat-'+uuid.uuid4().hex[:20]
+    conn.execute("""INSERT INTO proposal_decisions(decision_id,proposal_uid,layer,verdict,reason_code,
+        confidence,judge_model,detail,target_note_id,meta_json) VALUES(%s,%s,'L4',%s,'duplicate',1,
+        'review_group','相同规则与原始证据沿用已有人工作出的裁决',%s,%s::jsonb)""",
+        (decision,uid,'reject' if rejected else 'merge',note,
+        json.dumps({'review_id':newest[0],'representative_uid':newest[2]})))
+    state, verdict = ('rejected','reject') if rejected else ('merged','merge')
+    conn.execute("UPDATE experience_proposals SET state=%s,merged_into_uid=%s,updated_at=now() WHERE uid=%s AND owner_id=%s",
+                 (state,note,uid,owner))
+    if note:
+        conn.execute("""INSERT INTO experience_relations(owner_id,from_uid,to_uid,relation,proposal_uid)
+            VALUES(%s,%s,%s,'duplicate',%s)""",(owner,uid,note,uid))
+    finish(conn,owner,uid,newest[2],note)
+    return dict(layer='L4',verdict=verdict,decision_id=decision,reason_code='duplicate',confidence=1.0)
+
+
+def _eligible(alias):
+    return f"""{alias}.state = 'review' AND NOT EXISTS (
+        SELECT 1 FROM review_decisions rd WHERE rd.proposal_uid={alias}.uid AND rd.owner_id={alias}.owner_id)
+        AND NOT EXISTS (SELECT 1 FROM proposal_decisions protected
+          WHERE protected.proposal_uid={alias}.uid AND protected.reason_code IN ('contested','wrong_scope'))
+        AND NOT COALESCE({alias}.review_guidance @> '[{{"needs_check":true}}]'::jsonb,false)
+        AND NOT EXISTS (SELECT 1 FROM proposal_decisions d WHERE d.proposal_uid={alias}.uid AND d.layer='L3'
+            AND (d.meta_json->>'relation' IN ('refines','scope_split','refuted','contested','outdated')
+                 OR d.verdict='review'))"""
+
+
+def group_rows(alias='p'):
+    return f"""FROM experience_proposals other
+        LEFT JOIN experience_review_members peer ON peer.proposal_uid=other.uid AND peer.owner_id=other.owner_id
+        LEFT JOIN experience_review_members mine ON mine.proposal_uid={alias}.uid AND mine.owner_id={alias}.owner_id
+        WHERE other.owner_id={alias}.owner_id AND mine.closed_with IS NULL AND peer.closed_with IS NULL
+          AND (other.uid={alias}.uid OR
+              (mine.rule_key=peer.rule_key AND mine.historical_anchor IS NOT DISTINCT FROM peer.historical_anchor) OR
+              (mine.historical_anchor=other.uid AND peer.proposal_uid IS NULL) OR
+              (peer.historical_anchor={alias}.uid AND mine.proposal_uid IS NULL))
+          AND {_eligible(alias)} AND {_eligible('other')}"""
+
+
+def representative_filter(alias='p'):
+    # live wins over backfill, then the oldest item wins. The physical source track never changes.
+    return f"""(NOT EXISTS (SELECT 1 FROM experience_review_members registered
+        WHERE registered.proposal_uid={alias}.uid AND registered.owner_id={alias}.owner_id)
+        OR NOT EXISTS (SELECT 1 {group_rows(alias)}
+        AND (peer.proposal_uid IS NOT NULL,other.source_track <> 'live',other.created_at,other.uid)
+          < (mine.proposal_uid IS NOT NULL,{alias}.source_track <> 'live',{alias}.created_at,{alias}.uid)))"""
+
+
+def group_size_expr(alias='p'):
+    return f"""CASE WHEN EXISTS (SELECT FROM experience_review_members m WHERE m.owner_id={alias}.owner_id
+        AND (m.proposal_uid={alias}.uid OR m.historical_anchor={alias}.uid))
+        THEN GREATEST(1,(SELECT COUNT(*) {group_rows(alias)})) ELSE 1 END"""
+
+
+def peers(conn, owner, uid, key, historical=False):
+    return conn.execute(f"""SELECT p.uid,p.source_kind,p.agent_client,p.model,p.evidence_json,m.evidence_source
+        FROM experience_review_members m JOIN experience_proposals p ON p.uid=m.proposal_uid
+        WHERE m.owner_id=%s AND p.owner_id=m.owner_id AND p.uid<>%s AND m.rule_key=%s
+          AND (m.historical_anchor IS NULL OR m.historical_anchor=%s OR NOT EXISTS (
+              SELECT FROM experience_proposals h WHERE h.uid=m.historical_anchor AND h.owner_id=m.owner_id
+                AND {_eligible('h')}))
+          AND (NOT %s OR m.historical_anchor=%s) AND m.closed_with IS NULL AND {_eligible('p')}
+        ORDER BY p.uid FOR UPDATE OF p""", (owner, uid, key, uid, historical, uid)).fetchall()
+
+
+def similar(conn, owner, uid, vector, threshold):
+    # These are suggestions; neither a score nor a chain of near neighbors proves equivalence.
+    rows = conn.execute("""SELECT uid,similarity FROM (
+        SELECT uid,1-(embedding <=> %s::vector) AS similarity FROM experience_proposals
+        WHERE owner_id=%s AND uid<>%s AND embedding IS NOT NULL AND state IN ('review','pending')
+        ORDER BY embedding <=> %s::vector LIMIT 5) candidates WHERE similarity >= %s""",
+        (vector,owner,uid,vector,threshold)).fetchall()
+    return [{'uid': u,'similarity': round(float(s),6)} for u,s in rows]
+
+
+def matching_notes(conn, owner, key, fields, vector=None, *, for_write=False):
+    problem, solution, reusable = fields[:3]
+    # Exact equality works without embeddings (including edited text). Vector candidates also
+    # include older manual notes, and the registry finds an approved paraphrase independent of ANN rank.
+    rows = conn.execute("""SELECT n.id,n.problem,n.solution,n.reusable_experience,n.scope,n.kind,n.misbelief,
+               n.pinned,n.importance FROM experience_notes n
+        WHERE n.owner_id=%s AND n.status='active' AND n.deleted_at IS NULL AND
+          (n.problem=%s OR n.solution=%s OR n.reusable_experience=%s OR n.id IN
+            (SELECT note_id FROM experience_review_members WHERE owner_id=n.owner_id AND rule_key=%s
+                AND note_id IS NOT NULL) OR n.id IN
+            (SELECT id FROM experience_notes WHERE owner_id=%s AND status='active' AND deleted_at IS NULL
+             AND embedding IS NOT NULL AND %s::vector IS NOT NULL ORDER BY embedding <=> %s::vector LIMIT 8))
+        ORDER BY n.pinned DESC,n.created_at,n.id""", (owner,problem,solution,reusable,key,owner,vector,vector)).fetchall()
+    for uid,p,s,r,scope,kind,misbelief,pinned,importance in rows:
+        if rule_key(p,s,r,scope,kind,misbelief) == key:
+            if not for_write:
+                return uid,1.0,pinned,importance
+            locked = conn.execute("""SELECT problem,solution,reusable_experience,scope,kind,misbelief,pinned,importance
+                FROM experience_notes WHERE id=%s AND owner_id=%s AND status='active' AND deleted_at IS NULL
+                FOR UPDATE SKIP LOCKED""",(uid,owner)).fetchone()
+            if not locked:
+                from evolvmem.experience_v2.gate.review_inbox import ReviewInboxError
+                raise ReviewInboxError('review_decision_busy',409)
+            if rule_key(*locked[:6])==key:
+                return uid, 1.0, locked[-2], locked[-1]
+    return None
+
+
+def certified_note(conn, owner, proof, fields, *, for_write=False):
+    if not proof or proof.get('target_kind') != 'note' or proof.get('challenger_key') != rule_key(*fields):
+        return None
+    row = conn.execute("""SELECT id,problem,solution,reusable_experience,scope,kind,misbelief,pinned,importance
+        FROM experience_notes WHERE id=%s AND owner_id=%s AND status='active' AND deleted_at IS NULL"""
+        + (' FOR UPDATE SKIP LOCKED' if for_write else ''),(proof['representative'],owner)).fetchone()
+    if not row and for_write and conn.execute("""SELECT 1 FROM experience_notes WHERE id=%s AND owner_id=%s
+        AND status='active' AND deleted_at IS NULL""",(proof['representative'],owner)).fetchone():
+        from evolvmem.experience_v2.gate.review_inbox import ReviewInboxError
+        raise ReviewInboxError('review_decision_busy',409)
+    if row and not row[-2] and row[-1]<8 and rule_key(*row[1:7])==proof['key']:
+        return row[0],proof['similarity'],row[-2],row[-1]
+    return None
+
+
+def evidence_key(item, session=''):
+    if not isinstance(item, dict):
+        return None
+    src = str(item.get('source') or item.get('source_ref') or '')
+    event = item.get('event', item.get('line_no'))
+    if src and event is not None:
+        if src.startswith('archive:') and session:
+            origin = json.loads(session)
+            digest = origin['events'].get(str(event))
+            if digest:
+                src = json.dumps([origin['family'],digest],ensure_ascii=False,separators=(',',':'))
+        return (item.get('library',''),src,str(event),item.get('kind',''))
+    return ('raw',json.dumps(item,sort_keys=True,ensure_ascii=False))
+
+
+def fresh_evidence(conn, owner, note_id, evidence, session):
+    row = conn.execute("""SELECT evidence FROM experience_notes WHERE id=%s AND owner_id=%s
+        FOR UPDATE""",(note_id,owner)).fetchone()
+    if row is None:
+        return []
+    old = row[0]
+    # For evidence already appended by another member use its original session ID, without
+    # assuming every pointer on the note came from the note creator's session.
+    known = {evidence_key(e) for e in (old or [])}
+    prior = conn.execute("""SELECT m.evidence_source,p.evidence_json FROM experience_review_members m
+        JOIN experience_proposals p ON p.uid=m.proposal_uid AND p.owner_id=m.owner_id
+        WHERE m.owner_id=%s AND m.note_id=%s""", (owner,note_id)).fetchall()
+    for src, entries in prior:
+        for e in entries or []:
+            if evidence_key(e) in known:
+                known.add(evidence_key(e,src))
+    out = []
+    for e in evidence or []:
+        raw, canonical = evidence_key(e), evidence_key(e,session)
+        if raw is None or raw in known or canonical in known:
+            continue
+        out.append(e)
+        known.update((raw,canonical))
+    return out
+
+
+def approved_note(conn, owner, uid, note_id, expected_key):
+    from evolvmem.experience_v2.gate import category_policy, review_guidance
+    if category_policy.owner_control(conn,owner)['force_review']:
+        return None
+    row = conn.execute("""SELECT n.revision,r.review_id,n.problem,n.solution,n.reusable_experience,n.scope,n.kind,n.misbelief
+        FROM experience_notes n JOIN review_decisions r ON r.owner_id=n.owner_id
+        AND (r.proposal_uid=n.proposal_uid OR EXISTS (SELECT 1 FROM experience_proposals prior
+            WHERE prior.uid=r.proposal_uid AND prior.owner_id=n.owner_id AND prior.merged_into_uid=n.id))
+        JOIN experience_proposals p ON p.uid=%s AND p.owner_id=n.owner_id
+        WHERE n.id=%s AND n.owner_id=%s AND n.status='active' AND n.deleted_at IS NULL
+        AND NOT n.pinned AND n.importance<8 AND NOT p.pinned AND p.importance<8
+        AND r.user_verdict IN ('accept','edit_accept','rescue') LIMIT 1""",(uid,note_id,owner)).fetchone()
+    if (row and rule_key(*row[2:])==expected_key
+            and not any(ref.get('needs_check') for ref in review_guidance.for_proposal(conn,owner,uid,freeze=True))):
+        return row[:2]
+    return None
+
+
+def link_approved(conn,uid):
+    row = conn.execute("""SELECT p.owner_id,p.state,p.evidence_json,d.target_note_id,d.decision_id,
+        d.meta_json->'reviewed_source' FROM experience_proposals p JOIN proposal_decisions d ON d.proposal_uid=p.uid
+        JOIN experience_review_members m ON m.proposal_uid=p.uid AND m.owner_id=p.owner_id
+        WHERE p.uid=%s AND d.layer='L1' AND d.meta_json ? 'reviewed_source' AND m.closed_with IS NULL
+        ORDER BY d.created_at DESC LIMIT 1 FOR UPDATE OF p""",(uid,)).fetchone()
+    if not row:
+        return False
+    owner,state,evidence,note_id,decision,receipt=row
+    if state not in ('review','pending') or not approved_note(conn,owner,uid,note_id,receipt['rule_key']):
+        return False
+    if receipt.get('after_value_gate') and not conn.execute("""SELECT 1 FROM proposal_decisions
+        WHERE proposal_uid=%s AND layer='L2b' AND verdict='pass' LIMIT 1""",(uid,)).fetchone():
+        return False
+    unchanged = conn.execute("""SELECT 1 FROM experience_notes WHERE owner_id=%s AND id=%s
+        AND revision=%s AND status='active' AND deleted_at IS NULL FOR SHARE SKIP LOCKED""",
+        (owner,note_id,receipt['revision'])).fetchone()
+    if not unchanged:
+        return False
+    conn.execute("""UPDATE proposal_decisions SET verdict='merge',detail='已人工确认的同一规则，仅保留本次来源'
+        WHERE decision_id=%s""",(decision,))
+    conn.execute("""INSERT INTO experience_relations(owner_id,from_uid,to_uid,relation,reason,evidence_ref,proposal_uid)
+        VALUES(%s,%s,%s,'duplicate','已采纳规则的新来源，未经独立事实复核',%s::jsonb,%s)""",
+        (owner,uid,note_id,json.dumps(evidence or [],ensure_ascii=False),uid))
+    conn.execute("""UPDATE experience_proposals SET state='merged',merged_into_uid=%s,updated_at=now()
+        WHERE uid=%s AND owner_id=%s""",(note_id,uid,owner))
+    finish(conn,owner,uid,uid,note_id)
+    return True
+
+
+def write_merge(conn, writer, ticket, op):
+    if op.evidence:
+        return writer.apply(conn,ticket,op)['experience']
+    # Replayed archive evidence remains on the original proposal for audit without
+    # incrementing the independent occurrence count or rewriting the note.
+    from evolvmem.experience_v2.writer import _SELECT_COLS, _row_to_note
+    writer.verify_ticket(conn,ticket,op)
+    row = conn.execute(f'SELECT {_SELECT_COLS} FROM experience_notes WHERE owner_id=%s AND id=%s',
+                       (op.owner_id,op.note_id)).fetchone()
+    return _row_to_note(row)
+
+
+def prepare_review(conn, owner, uid, edits):
+    mark = member(conn,owner,uid)
+    if not mark:
+        row = conn.execute("""SELECT problem,solution,reusable_experience,scope,kind,misbelief
+            FROM experience_proposals WHERE uid=%s AND owner_id=%s AND op='add' AND source_kind IN ('pipeline','agent')
+            AND state='review' AND NOT pinned AND importance<8""",(uid,owner)).fetchone()
+        if not row:
+            return None,None
+        key = rule_key(*row)
+        lock_keys(conn,owner,[key])
+        linked = conn.execute("""SELECT 1 FROM experience_review_members WHERE owner_id=%s
+            AND historical_anchor=%s AND closed_with IS NULL LIMIT 1""",(owner,uid)).fetchone()
+        if edits and any(edits.get(field,value)!=value for field,value in zip(
+                ('problem','solution','reusable_experience'),row[:3])):
+            return None,None
+        return None,key if linked else None
+    effective_key = mark[0]
+    if edits:
+        row = conn.execute("""SELECT problem,solution,reusable_experience,scope,kind,misbelief,category,source_kind
+            FROM experience_proposals WHERE uid=%s AND owner_id=%s""",(uid,owner)).fetchone()
+        p,s,r,scope,kind,misbelief,category,source_kind = row
+        fields = tuple(str(edits.get(k,v)).strip() for k,v in (('problem',p),('solution',s),('reusable_experience',r)))
+        if source_kind == 'agent' or (edits.get('category',category),*fields) != (category,p,s,r):
+            from evolvmem.experience_v2.pitfall_trigger import without_signature
+            scope = without_signature(scope)
+        edited_key = rule_key(*fields,scope,kind,misbelief)
+        if edited_key != rule_key(p,s,r,row[3],kind,misbelief):
+            effective_key = edited_key
+    lock_keys(conn,owner,[mark[0],effective_key])
+    return member(conn, owner, uid), effective_key
+
+
+def close_equivalents(conn, owner, reviewer, uid, key, note_id, review_id, issuer, writer, historical=False):
+    from evolvmem.experience_v2.writer import Op
+    import uuid
+    from evolvmem.experience_v2.gate import review_guidance
+    for peer, source_kind, client, model, evidence, source in peers(conn,owner,uid,key,historical):
+        if any(ref.get('needs_check') and ref.get('proposal_uid')!=uid
+               for ref in review_guidance.for_proposal(conn,owner,peer,freeze=True)):
+            continue
+        decision = 'dec-group-' + uuid.uuid4().hex[:20]
+        verdict = 'merge' if note_id else 'reject'
+        conn.execute("""INSERT INTO proposal_decisions(
+            decision_id,proposal_uid,layer,verdict,reason_code,confidence,judge_model,detail,target_note_id,meta_json)
+            VALUES (%s,%s,'L4',%s,'duplicate',1.0,'review_group','共享已确认的同一规则裁决',%s,%s::jsonb)""",
+            (decision,peer,verdict,note_id,json.dumps({'review_id':review_id,'representative_uid':uid})))
+        if note_id:
+            verified = conn.execute("""SELECT 1 FROM proposal_decisions WHERE proposal_uid=%s
+                AND layer='L0' AND verdict='pass' LIMIT 1""", (peer,)).fetchone()
+            if verified:
+                additions = fresh_evidence(conn,owner,note_id,evidence,source)
+                if additions:
+                    ticket = issuer.issue(proposal_uid=peer,decision_id=decision,lane='gated')
+                    writer.apply(conn,ticket,Op(action='merge_evidence',note_id=note_id,owner_id=owner,
+                        actor_id=reviewer,request_id='group:'+peer,origin=source_kind,evidence=additions,
+                        agent_client=client,model=model))
+            conn.execute("""INSERT INTO experience_relations(owner_id,from_uid,to_uid,relation,reason,evidence_ref,proposal_uid)
+                VALUES(%s,%s,%s,'duplicate','等价规则共享人工决定',%s::jsonb,%s)""",
+                (owner,peer,note_id,json.dumps(evidence or [],ensure_ascii=False),peer))
+        conn.execute("""UPDATE experience_proposals SET state=%s,merged_into_uid=%s,updated_at=now()
+            WHERE uid=%s AND owner_id=%s""", ('merged' if note_id else 'rejected',note_id,peer,owner))
+        finish(conn,owner,peer,uid,note_id)
+
+
+def finish(conn, owner, uid, canonical, note_id=None):
+    conn.execute("""UPDATE experience_review_members SET closed_with=%s,note_id=%s
+        WHERE proposal_uid=%s AND owner_id=%s AND closed_with IS NULL""", (canonical,note_id,uid,owner))
